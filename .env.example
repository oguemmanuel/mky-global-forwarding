# Public URL of the site (used for canonical links, sitemap and Open Graph)
NEXT_PUBLIC_SITE_URL=https://mkyglobalforwarding.com

# Set to "true" on preview deployments: shows the preview banner and blocks search indexing
NEXT_PUBLIC_PREVIEW_BANNER=false

# Admin page (/admin): shared password for MKY staff. Required to see quotes and website data.
ADMIN_PASSWORD=change-me

# Database (Phase 1 production). Without these, data is saved to .data/store.json locally.
# Supabase > Project settings > API. The service role key is secret: server only, never commit it.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Phase 2: email notifications for new quotes (https://resend.com)
RESEND_API_KEY=
QUOTE_INBOX=ship@mkyglobalforwarding.com
MAIL_FROM="MKY Website <website@mkyglobalforwarding.com>"
